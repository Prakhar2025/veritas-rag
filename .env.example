# Veritas RAG configuration template. Copy to .env and fill in. Never commit .env.

# AWS
VERITAS_AWS_REGION=us-east-1
# Optional named AWS profile; leave empty to use the default credential chain
VERITAS_AWS_PROFILE=

# Model identifiers (deprecation guard: identifiers live here, never in code)
VERITAS_NOVA_MICRO_MODEL_ID=amazon.nova-micro-v1:0
# Llama 3.3 70B runs through its inference profile (verified access)
VERITAS_GENERATOR_MODEL_ID=us.meta.llama3-3-70b-instruct-v1:0

# Embeddings: provider is fastembed (local, torch free) or hash (deterministic, tests)
VERITAS_EMBEDDINGS_PROVIDER=fastembed
VERITAS_EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5

# Chat provider: bedrock or fake (deterministic, tests)
VERITAS_CHAT_PROVIDER=bedrock

# Reranker: provider is fastembed (local cross encoder) or identity (deterministic, tests)
VERITAS_RERANKER_PROVIDER=fastembed
VERITAS_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# API service
VERITAS_CORS_ORIGINS=http://localhost:3000
VERITAS_RATE_LIMIT_PER_MINUTE=30

# Reranker: provider is fastembed (local cross encoder) or identity (deterministic, tests)
VERITAS_RERANKER_PROVIDER=fastembed
VERITAS_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# API service
VERITAS_CORS_ORIGINS=http://localhost:3000
VERITAS_RATE_LIMIT_PER_MINUTE=30

# Budget
VERITAS_SPEND_CAP_USD=5.0

# Chunking
VERITAS_CHUNK_TARGET_TOKENS=300
VERITAS_CHUNK_OVERLAP_TOKENS=45
VERITAS_PARENT_MAX_TOKENS=1200
